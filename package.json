{
  "name": "english-skill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/check-node-version.mjs && (npx wrangler dev & vite)",
    "db:local:sync": "node scripts/sync-local-d1-from-remote.mjs",
    "build:my-words": "node scripts/build-my-words.mjs",
    "test:server": "npm run build:my-words && node worker/test/api.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "migrate:to-d1": "node scripts/migrate-to-d1.mjs",
    "build": "npm run build:my-words && tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build:my-words && npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "pinyin-pro": "^3.29.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.150.0"
  }
}
