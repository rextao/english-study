node_modules/
dist/

# 本地环境变量（包含 API Key），不要提交
.env
.env.*
!.env.example

# ECDICT 原始数据与编译产物：csv 约 200MB，索引十几 MB，都不进 git
# 换台机器跑 npm run ecdict:fetch 重新装
data/

.DS_Store
.idea/

# 本机永久学习历史及删除前自动备份
cache/*.sqlite-wal
cache/*.sqlite-shm
cache/backups/
cache/dict-cache.json.bak

# 唯一的落盘数据文件：学习列表 / 学习历史 / 词库标签 / 目标 / 打印批次 / 词典缓存都在这一个库里，
# 提交它就能在另一台机器 git pull 拿到完整数据（库里其余文件都是备份 / 临时产物，不进 git）
cache/*
!cache/study-history.sqlite
