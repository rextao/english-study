# 这个文件只放两类「非 Worker」配置：
#   1. vite 构建期变量（VITE_*，会被打进前端 bundle，别放私密密钥）；
#   2. 本地命令行 `npm run study` 用的 STUDY_*。
# Worker 自己的本地变量 / 密钥（API_TOKEN、百度、Google TTS）不在这里，写 .dev.vars（见 README「环境变量文件分工」）。
# 本地复制成 .env.local 再填；.env.local 不进 git。

# PostHog 会话回放：填 PostHog 项目的 Project API Key（phc_ 开头），
# 留空则不初始化 PostHog，界面上也不会出现同意条。
VITE_POSTHOG_KEY=

# PostHog 接入地址，默认美区；EU 区域或自建代理时改这里。
VITE_POSTHOG_HOST=https://us.i.posthog.com

# 本地命令行（npm run study）使用；不带 VITE_ 前缀，不会打进前端 bundle。
# 复制到 .env.local 再填；STUDY_API_TOKEN 就是 Worker secret 里的 API_TOKEN。
STUDY_API_BASE=https://study.rextao666.xyz
STUDY_API_TOKEN=

# 说明：上面四项都有代码读取（VITE_POSTHOG_* 在 src/utils/analytics.ts，
# STUDY_* 在 scripts/study-cli.mjs），留空只会关闭对应功能，不是无用变量。


# 想验证真实中文翻译就填百度密钥；不填则本地查词拿不到中文（缓存命中的除外）
BAIDU_TRANSLATE_API_KEY=
BAIDU_TRANSLATE_APP_ID=
