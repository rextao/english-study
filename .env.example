# 前端构建期变量（vite 只注入 VITE_ 前缀的变量，会被打进 bundle，别放私密密钥）。
# 本地复制成 .env.local 再填；.env.local 不进 git。

# PostHog 会话回放：填 PostHog 项目的 Project API Key（phc_ 开头），
# 留空则不初始化 PostHog，界面上也不会出现同意条。
VITE_POSTHOG_KEY=

# PostHog 接入地址，默认美区；EU 区域或自建代理时改这里。
VITE_POSTHOG_HOST=https://us.i.posthog.com

# 本地命令行（npm run study）使用；不带 VITE_ 前缀，不会打进前端 bundle。
# 复制到 .env.local 再填；STUDY_API_TOKEN 就是 Worker secret 里的 API_TOKEN。
STUDY_API_BASE=https://study.rextao666.xyz
STUDY_API_TOKEN=
